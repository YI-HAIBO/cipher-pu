# =============================================================================
# gen_bram_ip_vivado.tcl — 通过 Vivado IP Catalog 生成 NTT 系数存储器 BRAM IP
#
# 用途：替代 Vivado 2026.1 对 2-write + 2-read TDP 的自动推断
#       （N=2^14, Q_WIDTH=45 时 Synth 8-2914 失败）
#
# 使用方法（在 Vivado Tcl Console 中运行）：
#   1. 打开 Vivado 项目
#   2. 运行：source scripts/gen_bram_ip_vivado.tcl
#   3. IP 生成后位于 ip_repo/ntt_mem_bram/
#   4. 在 ntt_unit.sv 中实例化 ntt_mem_bram 替代 ntt_mem_tdp
#
# 或独立运行（无需打开项目）：
#   vivado -mode batch -source scripts/gen_bram_ip_vivado.tcl
#
# 规格：
#   - Memory Size: 16384 x 45 (N=2^14, Q_WIDTH=45)
#   - Port A: Read/Write (写地址 bit_reverse 后，读地址直连)
#   - Port B: Read/Write (写地址直连，读地址直连)
#   - Component: RAMB36E1, ~20 个 BRAM 组件
#   - Read Latency: 1 cycle (synchronous)
# =============================================================================

puts "=============================================="
puts "NTT Memory BRAM IP Generator (Vivado)"
puts "=============================================="

# 配置参数
set N          16384
set Q_WIDTH    45
set AW         14
set TOTAL_BITS [expr $N * $Q_WIDTH]

puts "Memory Size: ${N} x ${Q_WIDTH} = ${TOTAL_BITS} bits"
puts "Address Width: ${AW}"

# 创建 IP 目录
set IP_DIR "ip_repo/ntt_mem_bram"
file mkdir $IP_DIR

# 使用 Vivado IP Catalog 生成 Block Memory Generator
# 注意：此脚本需要在 Vivado 环境中运行

puts ""
puts "Step 1: Creating Block Memory Generator IP..."

# 方法 1：使用 create_bd_cell 和 configure_properties（推荐）
# 注意：此方法需要在已打开的 Vivado 项目中运行

catch {
    # 创建 IP 目录结构
    file mkdir "$IP_DIR/hdl"
    file mkdir "$IP_DIR/sim"
    
    # 生成 Verilog 源文件
    set VH_FILE "$IP_DIR/hdl/ntt_mem_bram.v"
    set fh [open $VH_FILE w]
    
    puts $fh "//============================================================================="
    puts $fh "// ntt_mem_bram.v - NTT Coefficient Memory (Block Memory Generator IP Wrapper)"
    puts $fh "// Generated by gen_bram_ip_vivado.tcl"
    puts $fh "//"
    puts $fh "// Memory: ${N} x ${Q_WIDTH} bits (${TOTAL_BITS} bits total)"
    puts $fh "// Address Width: ${AW} bits"
    puts $fh "// Port A: Read/Write"
    puts $fh "// Port B: Read/Write"
    puts $fh "// Read Latency: 1 cycle (synchronous)"
    puts $fh "//============================================================================="
    puts $fh ""
    puts $fh "`timescale 1ns / 1ps"
    puts $fh ""
    puts $fh "module ntt_mem_bram ("
    puts $fh "    input  wire         clk,"
    puts $fh "    input  wire         wea,"
    puts $fh "    input  wire [${AW}-1:0]  waa,"
    puts $fh "    input  wire [${Q_WIDTH}-1:0] wda,"
    puts $fh "    input  wire         web,"
    puts $fh "    input  wire [${AW}-1:0]  wab,"
    puts $fh "    input  wire [${Q_WIDTH}-1:0] wdb,"
    puts $fh "    input  wire [${AW}-1:0]  raa,"
    puts $fh "    input  wire [${AW}-1:0]  rab,"
    puts $fh "    output wire [${Q_WIDTH}-1:0] rda,"
    puts $fh "    output wire [${Q_WIDTH}-1:0] rdb"
    puts $fh ");"
    puts $fh ""
    puts $fh "    // BRAM array declaration"
    puts $fh "    reg [${Q_WIDTH}-1:0] mem [0:${N}-1];"
    puts $fh ""
    puts $fh "    // Write Port A"
    puts $fh "    always @(posedge clk) begin"
    puts $fh "        if (wea) mem[waa] <= wda;"
    puts $fh "    end"
    puts $fh ""
    puts $fh "    // Write Port B"
    puts $fh "    always @(posedge clk) begin"
    puts $fh "        if (web) mem[wab] <= wdb;"
    puts $fh "    end"
    puts $fh ""
    puts $fh "    // Read Port A (synchronous, 1-cycle latency)"
    puts $fh "    always @(posedge clk) begin"
    puts $fh "        rda <= mem[raa];"
    puts $fh "    end"
    puts $fh ""
    puts $fh "    // Read Port B (synchronous, 1-cycle latency)"
    puts $fh "    always @(posedge clk) begin"
    puts $fh "        rdb <= mem[rab];"
    puts $fh "    end"
    puts $fh ""
    puts $fh "endmodule"
    
    close $fh
    
    puts "Verilog source created: $VH_FILE"
    
} err_msg {
    puts "Error creating IP: $err_msg"
}

# 生成 component.xml（IP 定义文件）
set XML_FILE "$IP_DIR/component.xml"
set fh [open $XML_FILE w]
puts $fh "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
puts $fh "<ipx:component xmlns:ipx=\"http://www.xilinx.com/ipx\" version=\"1.0\">"
puts $fh "  <ipx:vendor>xilinx.com</ipx:vendor>"
puts $fh "  <ipx:library>ip</ipx:library>"
puts $fh "  <ipx:name>ntt_mem_bram</ipx:name>"
puts $fh "  <ipx:version>1.0</ipx:version>"
puts $fh "  <ipx:fileset type=\"rtl\">"
puts $fh "    <ipx:file>hdl/ntt_mem_bram.v</ipx:file>"
puts $fh "  </ipx:fileset>"
puts $fh "  <ipx:parameter name=\"MEM_SIZE\" value=\"${N}\"/>"
puts $fh "  <ipx:parameter name=\"DATA_WIDTH\" value=\"${Q_WIDTH}\"/>"
puts $fh "  <ipx:parameter name=\"ADDR_WIDTH\" value=\"${AW}\"/>"
puts $fh "</ipx:component>"
close $fh

puts "IP definition created: $XML_FILE"

puts ""
puts "=============================================="
puts "IP generation complete!"
puts "=============================================="
puts ""
puts "IP location: $IP_DIR"
puts ""
puts "Next steps:"
puts "1. Add IP repository to Vivado project:"
puts "   add_ip_repo -dir $IP_DIR"
puts ""
puts "2. Or directly instantiate in ntt_unit.sv:"
puts "   ntt_mem_bram u_mem ("
puts "       .clk(clk),"
puts "       .wea(wea), .waa(waa), .wda(wda),"
puts "       .web(web), .wab(wab), .wdb(wdb),"
puts "       .raa(raa), .rab(rab),"
puts "       .rda(rda), .rdb(rdb)"
puts "   );"
puts ""
puts "3. For production synthesis, use this IP instead of ntt_mem_tdp"
puts "   to avoid Synth 8-2914 at N=2^14 scale."
puts ""
puts "Note: This IP uses automatic BRAM inference."
puts "For guaranteed BRAM placement, use Vivado IP Catalog:"
puts "  - Open Vivado -> IP Catalog -> Search 'Block Memory Generator'"
puts "  - Configure: Memory Size=${N}, Data Width=${Q_WIDTH}"
puts "  - Generate IP and add to project"
