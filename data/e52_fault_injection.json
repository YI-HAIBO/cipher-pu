  "key_recovery": {
    "success_probability_claim": "0 under F1-F3 single-fault classes",
    "structural_argument": "keyswitch output = sum d_i*(b_i + a_i*s); fault Delta in b_i yields output difference d_i*Delta, both known to the attacker -> no information about s",
    "persistent_key_faults": "detected by noise erosion within 1 (k>=15) to <=5 (k>=10) multiplications",
    "caveat": "decryption-failure-oracle class applies only if the on-chip DARE decryption path (Sec 5.4) is deployed; wrap detection + constant-time rounding are declared prerequisites"
  },
  "detection_quantification": {
    "rule": "single-coefficient fault of magnitude f detected iff f > sqrt(rho*N)*n0",
    "rho": 0.25,
    "N": 4096,
    "n0_bits": 9.7,
    "k_det": 15,
    "complementarity": "harmful magnitude >= detection magnitude; undetectable => absorbed by noise floor",
    "key_register_rule": {
      "k>=15": "first multiplication",
      "10<=k<15": "<=5 multiplications",
      "k<10": "merged into noise floor (benign)"
    }
  },
